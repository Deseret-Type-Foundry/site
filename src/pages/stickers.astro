---
import Base from '../layouts/Base.astro';
import { STICKERS, SHOP_URL } from '../data/catalog';
---

<Base title="Stickers" active="stickers">
  <div class="stack" style="padding:72px var(--gutter) 48px;text-align:center;align-items:center;gap:22px">
    <div class="ckicker"><i></i>Stickers &amp; goods<i></i></div>
    <h1 class="title">The periodic table, in Deseret</h1>
    <p class="lede" style="max-width:560px">Element stickers set in the foundry's typefaces. Sold through our shop partner, which handles printing and shipping.</p>
  </div>

  <section class="wrap stickers" style="padding-top:16px">
    {STICKERS.map((s) => (
      <a href={SHOP_URL} target="_blank" rel="noopener" class="frame sticker">
        <div class="in stack">
          <div class="img"><img src={s.img} alt={s.alt} style={`transform:rotate(${s.rot}deg)`} /></div>
          <div style="padding:18px 20px 20px;display:flex;justify-content:space-between;align-items:flex-end;gap:12px;border-top:1px solid var(--line)">
            <div class="stack" style="gap:6px">
              <span class="accent" style="font-size:11px;letter-spacing:.24em">{s.no}</span>
              <span class="up" style="font-size:18px;font-weight:600;letter-spacing:.22em">{s.name}</span>
            </div>
            <span class="up" style="font-size:11px;letter-spacing:.2em;white-space:nowrap;border-bottom:1px solid var(--accent);padding-bottom:2px">Buy at shop ↗</span>
          </div>
        </div>
      </a>
    ))}
    <div class="frame dashed">
      <div class="in stack" style="align-items:center;justify-content:center;gap:10px;padding:32px;text-align:center;min-height:240px">
        <span class="label">More elements</span>
        <span style="font-size:14px;font-weight:300">Forthcoming</span>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-top:64px;padding-bottom:72px">
    <div style="border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:28px 0;display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between">
      <span style="font-size:15px;font-weight:300">Stickers ship from our shop partner. Font licenses are sold here on deseret.ink.</span>
      <a href={SHOP_URL} target="_blank" rel="noopener" class="btn">Visit the shop ↗</a>
    </div>
  </section>
</Base>
