---
import Base from '../layouts/Base.astro';
import { PRODUCTS, SHOP_URL } from '../data/catalog';

const SITE = 'https://deseret.ink';
// schema.org Product markup. No `offers`: prices live with the seller (The Outer Veil), and Google rejects an Offer without a price.
const jsonLd = PRODUCTS.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.kind === 'Sticker' ? `${p.name} (${p.no}) sticker` : p.name,
  description: p.description,
  image: SITE + p.img,
  url: SHOP_URL,
  brand: { '@type': 'Brand', name: 'Deseret Type Foundry' },
  category: p.kind,
}));
---

<Base title="Products" description="Periodic-table stickers and posters in the Deseret alphabet, available at The Outer Veil." active="products">
  <div class="stack" style="padding:72px var(--gutter) 48px;text-align:center;align-items:center;gap:22px">
    <div class="ckicker"><i></i>Stickers &amp; posters<i></i></div>
    <h1 class="title">The periodic table in the Deseret</h1>
    <p class="lede" style="max-width:560px">Stickers and posters.  Available exclusively at <a href="https://www.outer-veil.com/">The Outer Veil</a> in Provo, Utah.</p>
  </div>

  <section class="wrap stickers" style="padding-top:16px;padding-bottom:72px">
    {PRODUCTS.map((p) => (
      <a href={SHOP_URL} target="_blank" rel="noopener" class:list={['frame', 'sticker', { wide: p.wide }]}>
        <div class="in stack">
          <div class="img">
            <img src={p.img} width={p.w} height={p.h} alt={p.alt} loading="lazy" decoding="async"
              style={p.rot ? `transform:rotate(${p.rot}deg)` : undefined} />
          </div>
          <div style="padding:18px 20px 20px;display:flex;justify-content:space-between;align-items:flex-end;gap:12px;border-top:1px solid var(--line)">
            <div class="stack" style="gap:6px">
              <span class="accent" style="font-size:11px;letter-spacing:.24em">{p.no ?? p.kind}</span>
              <span class="up" style="font-size:18px;font-weight:600;letter-spacing:.22em">{p.name}</span>
            </div>
          </div>
        </div>
      </a>
    ))}
    <div class="frame dashed">
      <div class="in stack" style="align-items:center;justify-content:center;gap:10px;padding:32px;text-align:center;min-height:240px">
        <span class="label">More elements</span>
        <span style="font-size:14px;font-weight:300">Forthcoming</span>
      </div>
    </div>
  </section>

  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</Base>
