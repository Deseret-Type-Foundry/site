---
import Base from '../layouts/Base.astro';

// PLACEHOLDER COPY — replace with the real terms before launch.
const Y = '◆', N = '—';
const compare = [
  ['Lorem ipsum dolor', Y, Y, Y],
  ['Sit amet consectetur', Y, Y, Y],
  ['Adipiscing elit sed', '1', '5', 'Unlimited'],
  ['Eiusmod tempor', N, Y, Y],
  ['Incididunt ut labore', N, Y, Y],
  ['Dolore magna aliqua', N, N, Y],
  ['Ut enim ad minim', N, N, Y],
];
const faqs = [
  ['Lorem ipsum dolor sit amet?', 'Consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.'],
  ['Consectetur adipiscing elit?', 'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.'],
  ['Sed do eiusmod tempor incididunt?', 'Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.'],
  ['Ut enim ad minim veniam?', 'Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium.'],
  ['Quis nostrud exercitation?', 'Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit.'],
];
const tiers = [
  { n: 'I', name: 'Personal', price: '$20 per weight · $80 family', items: ['Lorem ipsum dolor sit amet', 'Consectetur adipiscing elit', 'Sed do eiusmod tempor'] },
  { n: 'II · Most chosen', name: 'Commercial', price: '$50 per weight · $200 family', hl: true, items: ['Lorem ipsum dolor sit amet', 'Ut enim ad minim veniam', 'Quis nostrud exercitation', 'Ullamco laboris nisi ut aliquip'] },
  { n: 'III', name: 'Enterprise', price: 'By quote', quote: true, items: ['Lorem ipsum dolor sit amet', 'Duis aute irure dolor', 'In reprehenderit in voluptate', 'Velit esse cillum dolore', 'Eu fugiat nulla pariatur'] },
];
---

<Base title="Licensing" noindex>
  <div class="stack sunburst" style="padding:72px var(--gutter) 56px;text-align:center;align-items:center;gap:22px;background:repeating-conic-gradient(from -2deg at 50% 100%,rgba(201,162,74,.08) 0deg 4deg,transparent 4deg 9deg)">
    <div class="ckicker"><i></i>Licensing<i></i></div>
    <h1 class="title">Three licenses, one agreement</h1>
    <p class="lede" style="max-width:600px">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
  </div>

  <section class="wrap" style="padding-top:24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:28px;align-items:stretch">
    {tiers.map((t) => (
      <div class:list={['frame', 'tier-card', { hl: t.hl }]}>
        <div class="in arch-160">
          <div class="stack" style="align-items:center;gap:10px;text-align:center">
            <span class="small-label" style="letter-spacing:.3em">{t.n}</span>
            <span class="up" style="font-size:24px;font-weight:600;letter-spacing:.24em">{t.name}</span>
            <span style="font-size:14px;font-weight:300">{t.price}</span>
          </div>
          <div style="height:1px;background:var(--line)"></div>
          <ul>{t.items.map((i) => <li>{i}</li>)}</ul>
          {t.quote && <a href="/about/#contact" class="btn-line" style="margin-top:auto;align-self:center">Request a quote</a>}
        </div>
      </div>
    ))}
  </section>

  <section class="wrap stack" style="padding-top:72px;gap:20px">
    <div class="kicker"><span>Compare</span><span class="rule"></span></div>
    <div style="overflow-x:auto">
      <div class="cmp">
        <span class="h">Use</span><span class="h" style="text-align:center">Personal</span><span class="h" style="text-align:center">Commercial</span><span class="h" style="text-align:center">Enterprise</span>
        {compare.map(([label, a, b, c]) => (
          <><span style="font-weight:300">{label}</span><span class="c">{a}</span><span class="c">{b}</span><span class="c">{c}</span></>
        ))}
      </div>
    </div>
  </section>

  <section class="stack faq" style="max-width:880px;margin:0 auto;padding:72px var(--gutter) 0;gap:8px">
    <div class="kicker" style="margin-bottom:12px"><span>Questions</span><span class="rule"></span></div>
    {faqs.map(([q, a], i) => (
      <details name="faq" open={i === 0}>
        <summary><span>{q}</span><i>◆</i></summary>
        <p>{a}</p>
      </details>
    ))}
  </section>

  <section class="wrap" style="padding-top:72px;padding-bottom:72px">
    <div class="frame block">
      <div class="in" style="padding:32px;display:flex;flex-wrap:wrap;gap:24px;align-items:center;justify-content:space-between">
        <div class="stack" style="gap:8px">
          <span class="up" style="font-size:18px;font-weight:600;letter-spacing:.2em">End User License Agreement</span>
          <span style="font-size:14px;font-weight:300">Lorem ipsum dolor sit amet, version 1.0.</span>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <a href="#" class="btn-line" style="padding:13px 18px 11px">Read online</a>
          <a href="#" class="btn" style="padding:14px 18px 12px;font-size:11px">Download PDF</a>
        </div>
      </div>
    </div>
  </section>
</Base>
