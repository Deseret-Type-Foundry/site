---
import Base from '../layouts/Base.astro';
---

<Base title="Account" active="account">
  <div class="wrap-narrow stack" style="padding-top:48px;padding-bottom:80px;gap:36px">
    <div class="frame block" style="max-width:460px;width:100%;margin:24px auto 0">
      <div class="in arch-200 stack" style="padding:64px 36px 32px;gap:16px">
        <div class="up" style="display:flex;justify-content:center;gap:24px;font-size:12px;letter-spacing:.24em">
          <span style="color:var(--accent);border-bottom:1px solid var(--accent);padding-bottom:6px">Sign in</span>
          <span style="opacity:.5;padding-bottom:6px">Register</span>
        </div>
        <!-- Preview: accounts arrive with the storefront (Supabase auth planned). -->
        <label class="field">Email<input type="email" placeholder="you@example.com" disabled /></label>
        <label class="field">Password<input type="password" placeholder="••••••••" disabled /></label>
        <button class="btn" disabled style="margin-top:6px;padding:15px 20px 13px">Opens at launch</button>
        <span class="note" style="text-align:center">
          Accounts, license downloads and order history arrive with the storefront.
          Nothing is stored yet.
        </span>
      </div>
    </div>
  </div>
</Base>
