---
import Base from '../layouts/Base.astro';
import { FAMILIES, HERO_LINE, sampleGlyphs } from '../data/catalog';

const meta = (f: (typeof FAMILIES)[number]) =>
  `${f.style} · ${f.weights.length} weights`;
---

<Base active="typefaces">
  <div class="hero">
    <div class="rings"></div>
    <div class="body">
      <div class="ckicker"><i></i>Typefaces for the Deseret alphabet<i></i></div>
      <h1 class="line">{HERO_LINE}</h1>
      <p>Deseret Alphabet typefaces expressing the spirit of the 1920s.</p>
    </div>
  </div>

  <div class="wrap stack" style="padding-top:64px;padding-bottom:56px;gap:32px">
    <div class="kicker"><span>The collection</span><span class="rule"></span></div>
    <div class="grid-cards">
      {FAMILIES.map((f) => {
        const Card = f.page ? 'a' : 'div'; // forthcoming families are a notice, not a link
        return (
        <Card href={f.page ? `/typefaces/${f.slug}/` : undefined} class="frame card">
          <div
            class="in arch-140"
            style={`background:${f.cardBg};${f.slug === 'hesperapis' ? 'border-color:#111;color:#111' : ''}`}
          >
            <div class="glyphs" style={`font-family:${sampleGlyphs(f).css};font-weight:${f.heroW};color:${f.fg}`}>{sampleGlyphs(f).text}</div>
            <div class="name">{f.name}</div>
            <div class="meta" style={`color:${f.status === 'free' ? 'inherit' : f.fg}`}>
              {f.status === 'free' && (<><span>Historical · 1 weight</span><span class="tag" style="background:#111;color:#fff">Free</span></>)}
              {f.status === 'soon' && (<><span>{f.kind ?? `${f.weights.length} weights`}</span><span class="tag" style={`border:1px solid ${f.fg}`}>Forthcoming</span></>)}
              {f.status === 'avail' && <span>{meta(f)}</span>}
            </div>
          </div>
        </Card>
        );
      })}
      <div class="frame dashed">
        <div class="in arch-140" style="padding:34px 26px 26px;display:flex;align-items:center;justify-content:center">
          <div class="label">Forthcoming</div>
        </div>
      </div>
    </div>
  </div>

  <div class="teaser">
    <img src="/assets/sticker-pu-sm.png" width="90" height="108" alt="Plutonium sticker" style="transform:rotate(-4deg)" />
    <div class="stack" style="align-items:center;gap:8px;text-align:center">
      <span class="label">Also available</span>
      <span style="font-size:20px;font-weight:300">Periodic table stickers</span>
      <a href="/products/" class="up" style="font-size:12px;letter-spacing:.2em;text-decoration:underline">Browse</a>
    </div>
    <img src="/assets/sticker-ag-sm.png" width="90" height="108" alt="Silver sticker" style="transform:rotate(4deg)" />
  </div>
</Base>
